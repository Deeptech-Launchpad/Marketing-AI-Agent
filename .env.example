# ─────────────────────────────────────────────────────────────
# marketing-agent — Phase 1
# Copy to .env and fill in. Every value below is validated at
# boot by src/config/env.ts; the process REFUSES TO START on a
# missing or malformed required value (no silent dev fallbacks).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# Same Postgres instance as NXT Sales, separate schema.
MARKETING_DATABASE_URL="postgresql://postgres:pgadmin123@127.0.0.1:5432/nxt_marketwiz?schema=marketing"
# Database connections — the PostgreSQL server is shared (100 in all), so keep
# these small. A connection_limit in MARKETING_DATABASE_URL itself wins.
MARKETING_DB_CONNECTION_LIMIT_API=3
MARKETING_DB_CONNECTION_LIMIT_WORKER=2
MARKETING_DB_POOL_TIMEOUT_SECONDS=20
PGBOSS_MAX_CONNECTIONS=1
# Superuser URL used ONLY by npm run db:extensions / db:indexes.
MARKETING_ADMIN_URL="postgresql://postgres:pgadmin123@127.0.0.1:5432/nxt_marketwiz"

# ── Auth ─────────────────────────────────────────────────────
# MUST be byte-identical to NXT Sales' JWT_SECRET — this service
# verifies tokens NXT Sales issued, and mints the service-account
# token it uses to call back. No fallback value exists.
JWT_SECRET=""
# First login with this email is auto-granted the tenant admin role.

# ── NXT Sales CRM ────────────────────────────────────────────
NXT_SALES_BASE_URL="http://localhost:4000"
# id of an existing NXT Sales User row this service acts as.
# See README "Service account" — no NXT Sales code change is needed.
NXT_SALES_SERVICE_USER_ID=""
NXT_SALES_SERVICE_USER_EMAIL="marketing-agent@service.local"
NXT_SALES_TIMEOUT_MS=12000
NXT_SALES_MAX_CONCURRENCY=4
NXT_SALES_MAX_PAGES=50

# ── Gemini ───────────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_API_BASE="https://generativelanguage.googleapis.com/v1beta"
# Leave blank to let the gateway discover the best available model.
GEMINI_MODEL_REASONING=""
GEMINI_MODEL_CONTENT=""
# NOTE: the vector column is vector(768). Changing the embedding
# model or dimension after ingestion means re-embedding everything.
GEMINI_MODEL_EMBEDDING="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_ATTEMPT_TIMEOUT_MS=60000
GEMINI_MAX_CONCURRENCY=4

# ── Budgets (hard ceilings, checked pre-dispatch) ────────────
BUDGET_MAX_TOKENS_PER_RUN=500000
BUDGET_MAX_USD_PER_RUN=5.00
MAX_AUDIENCE_SIZE=500
MAX_STEPS_PER_RUN=30
MAX_RESEARCH_PAGES_PER_RUN=15

# ── Safety ───────────────────────────────────────────────────
# Phase 1 has no write tools at all; dry_run is the only mode.
DEFAULT_RUN_MODE=dry_run
KILL_SWITCH_ENABLED=false
ALLOW_SELF_APPROVAL=false
APPROVAL_TTL_HOURS=168

# ── Research ─────────────────────────────────────────────────
# No search provider is wired yet. Leave "none" to run RESEARCH
# with page fetches only (it degrades, it does not fail).
SEARCH_API_PROVIDER=none
SEARCH_API_KEY=""
RESEARCH_USER_AGENT="MarketingAgent/1.0 (+contact via CRM administrator)"
RESEARCH_FETCH_TIMEOUT_MS=12000
RESEARCH_MAX_BYTES=2097152
RESEARCH_MAX_REDIRECTS=3
RESEARCH_CACHE_TTL_HOURS=168
# ── Outreach TEST MODE sending ──────────────────────────────
# off (default) = the platform sends nothing. test = emails go ONLY to the
# internal test inboxes below; the real recipient is never contacted.
# There is no "live" value: real customer sending is not implemented.
OUTREACH_EMAIL_MODE=off
# Allow-list: exact addresses and/or @domain entries, comma-separated.
OUTREACH_TEST_RECIPIENTS=""
# Where scheduled test sends go (must be on the allow-list).
OUTREACH_TEST_INBOX=""
# capture = record the email locally, no network. smtp = deliver via SMTP.
OUTREACH_TEST_TRANSPORT=capture
# These also send the one-time codes for Create Account and Forgot Password.
# Without SMTP_HOST nobody can receive a code, so neither can be completed.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Bulk Email Upload (Outreach → Bulk email). The platform sends these itself,
# one at a time. The SMTP account below carries them; leave it empty to use the
# system SMTP_* account above. The From the customer sees is set on the Bulk
# email screen and is only used after the sender check shows this account may
# send as it (its own address, or a verified Gmail "Send mail as" address whose
# domain's DMARC policy allows it). Nothing is sent while BULK_EMAIL_ENABLED=false.
BULK_EMAIL_ENABLED=false
BULK_SMTP_HOST=""
BULK_SMTP_PORT=587
BULK_SMTP_SECURE=false
BULK_SMTP_USER=""
BULK_SMTP_PASS=""
# Email open tracking for Bulk Email. Leave off until (1) a public HTTPS address
# reaches this API — the address must serve /api/v1/bulk-open/ping.gif — and
# (2) your privacy policy / consent wording covers recording email opens.
# Example (not real): BULK_OPEN_TRACKING_BASE_URL="https://marketing.example.com"
# How bulk emails are sent: "smtp" = the mailbox above; "crm" = through NXT Sales'
# Gmail pipeline and its own open tracking (needs NXT Sales' /api/marketing-bulk
# API with MARKETING_SERVICE_USER_ID and MARKETING_BULK_SENDER_USER_ID set there).
BULK_SEND_VIA=smtp
BULK_OPEN_TRACKING_ENABLED=false
BULK_OPEN_TRACKING_BASE_URL=""
OUTREACH_TEST_DISPATCH_INTERVAL_MINUTES=5

# Reddit's official API, used by Intent Signals to read Reddit threads it finds
# (Reddit refuses anonymous reads). Optional; without it Reddit threads are
# skipped and the run says so. Create a "script" app at reddit.com/prefs/apps.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# ── Knowledge ────────────────────────────────────────────────
KNOWLEDGE_MAX_UPLOAD_CHARS=400000
# Relevance floor for vector hits. Provisional - re-tune against the real
# corpus using scripts/retrieval-report.mjs.
KNOWLEDGE_MIN_COSINE=0.55

# ── Tenancy ──────────────────────────────────────────────────
DEFAULT_TENANT_SLUG=altiusnxt
DEFAULT_TENANT_NAME="AltiusNXT"

# ── Test / offline switches ──────────────────────────────────
# fake  -> deterministic in-memory adapters (no network, no cost)
# real  -> live NXT Sales / Gemini
CRM_DRIVER=real
LLM_DRIVER=real

# ── Stage 3: intent detection ────────────────────────────────
# Apify is ONE collection provider behind the IntentProvider boundary, not the
# engine. Leave APIFY_TOKEN empty to run intent detection with the CRM,
# technology and careers-page providers only.
APIFY_TOKEN=""
APIFY_JOBS_ACTOR="misceres~indeed-scraper"
# Hard ceiling per company. At $0.006/listing on the FREE tier this bounds the
# spend of a single collection to a known number.
APIFY_MAX_RESULTS_PER_COMPANY=10
APIFY_TIMEOUT_MS=120000
# The configured Actor cannot scope to one company - see src/config/env.ts.
APIFY_JOBS_COMPANY_SCOPED=false
# Freshness thresholds in days. Intent is time-sensitive; a two-year-old job
# posting is not current need.
INTENT_FRESH_DAYS=30
INTENT_AGING_DAYS=90
# Live Intent monitoring: re-run Intent Signals on a schedule for companies
# being worked (a manual run in the last 90 days, or an active sequence).
# Each re-check spends search/model budget, so it is off by default.
INTENT_MONITOR_ENABLED=false
INTENT_MONITOR_INTERVAL_HOURS=24
INTENT_MONITOR_MIN_DAYS=7
INTENT_MONITOR_MAX_COMPANIES=10
# Public web research (Decision Makers and Intent Signals). Opt-in.
PUBLIC_RESEARCH_ENABLED=false
DM_MODEL_READER_ENABLED=false
# Decision Makers: how many open-web pages its people-searches read (1-10).
DM_PUBLIC_RESEARCH_MAX_PAGES=8

# ── Development-only bypasses ────────────────────────────────
# Both flags below relax a production safety rule for local work. Each is
# refused at process start when NODE_ENV=production — the process prints why
# and exits 1 rather than serving with the rule disabled. Leave them false
# unless you are working locally on the stage they gate.
#
# Permits a customer-facing Workbench to be built from a report that has NOT
# been approved in Task #980.
WORKBENCH_ALLOW_UNAPPROVED=false
# Permits a customer report PDF from an unapproved report, and without the
# configured legal disclaimer.
REPORT_ALLOW_UNAPPROVED=false

# ── Customer report (Phase 6) ────────────────────────────────
# REQUIRED before any customer-facing report can be generated. Empty by
# default and the generator fails closed: Team Answer F.6 reserves this wording
# for legal/compliance, and the platform will not invent it.
REPORT_LEGAL_DISCLAIMER=""
# Before/after examples shown on a courier report. The approved band is 2-5.
REPORT_CUSTOMER_SAMPLE_COUNT=3

# ── Email verification (Team Answer, Section 4) ───────────────
# Hunter.io and Verifalia adapters are built. With no key, no address is
# verified and none becomes outreach-ready.
EMAIL_VERIFICATION_PROVIDER=""
HUNTER_API_KEY=""
VERIFALIA_USERNAME=""
VERIFALIA_PASSWORD=""

# ── RELEASE GATE 1: legal disclaimer ─────────────────────────
# >>> INSERT THE APPROVED LEGAL WORDING ON THE LINE BELOW <<<
# Team Answer F.6 reserves this for legal/compliance. It is empty by default
# and generateCustomerReport() throws until it is set, so a placeholder cannot
# ship on a document sent to a prospect. This is the ONLY place the wording is
# configured; it is never a literal in the renderer.
REPORT_LEGAL_DISCLAIMER=""

# ── RELEASE GATE 2: NXT Sales writes ─────────────────────────
# Off by default. The approved scope exists; approving a scope is not opening
# the path. Even once enabled, every package stops at awaiting_user_approval
# until a person reviews and approves it.
#
# The destination fields are CONFIRMED PRESENT on the live Company record:
#   Intent Score          Number     key: intentScore
#   Qualification Status  Dropdown   key: qualificationStatus
# (They are absent from the local restored snapshot, which predates them.)
#
# Because qualificationStatus is a DROPDOWN, NXT Sales rejects any value
# outside its option list. Map each of our four statuses onto a real option
# from "Manage values" on the live field, or the write returns 400:
# Confirmed display values (create these four options under "Manage values"
# on the live Qualification Status field — the dropdown is currently empty):
#   Not Qualified / Qualified / Qualified - Unassigned / De-qualified
#
# Owner reassignment, Deal creation and Deal value/stage stay refused at every
# setting and are deliberately not configurable.
CRM_WRITE_ENABLED=false
CRM_WRITE_FIELD_INTENT_SCORE="intentScore"
CRM_WRITE_FIELD_QUALIFICATION_STATUS="qualificationStatus"
CRM_WRITE_QUALIFICATION_VALUE_MAP="not_qualified=Not Qualified;qualified=Qualified;qualified_unassigned=Qualified - Unassigned;de_qualified=De-qualified"
# "Add to NXT Sales": the Company custom field that marks companies from this
# platform. Create it once with `npm run crm:setup-lead-source`, then set:
CRM_LEAD_SOURCE_FIELD=
CRM_LEAD_SOURCE_VALUE=Marketing AI Agent

# ── Qualified lead assignment: REGION-WISE round-robin ───────
# Confirmed rule: find the sales group for the company's region, then rotate
# within that group. There is NO global round-robin.
#
# Format — regions separated by ";", user ids within a region by ",":
#   SALES_REGION_ROUND_ROBIN="US:idA,idB;GB:idA;AE:idB"
#
# Region keys are matched against the company's country after normalisation,
# so "USA", "United States" and "US" all resolve to the US group.
#
# A lead whose region has no configured group is left UNASSIGNED with the
# reason surfaced. That is deliberate: routing it anyway would mean inventing
# a region-to-user mapping.
#
# Validated user ids in this environment:
#   Manoj s       manoj@altiusnxt.com        cmrela8ow0001mgntynarnkw8
#   Mohana Priya  mohanapriya@altiusnxt.com  cmreneaz8006313psmiykgmf0
SALES_REGION_ROUND_ROBIN=""

# ── LIVE NXT Sales connectivity (NOT YET ACTIVE) ─────────────
# The live CRM verifies a bearer token by SIGNATURE ONLY —
#   jwt.verify(token, process.env.JWT_SECRET)
#   (project/server/src/middleware/authMiddleware.js)
# — with no session store and no per-request user lookup. The live JWT_SECRET
# is therefore the ENTIRE credential. Treat it accordingly: anyone holding it
# can mint a token for any identity, and NXT Sales performs no role check on
# any write route.
#
# The local secret is NOT accepted by live (verified: 401), which is the
# correct separation. A live credential must be supplied deliberately.
#
# TO POINT THE PLATFORM AT LIVE, set all three together — a live base URL with
# a local secret makes every call 401:
#   NXT_SALES_BASE_URL="https://nxtsales.altiusnxt.tech"
#   JWT_SECRET="<the LIVE NXT Sales JWT_SECRET>"
#   NXT_SALES_SERVICE_USER_ID="<a real live User id for the service account>"
#   NXT_SALES_SERVICE_USER_EMAIL="marketing-agent@service.local"
#
# NOTE ON THE SERVICE USER: because verification is signature-only, a token
# whose `id` matches no User row is still ACCEPTED. It should nevertheless be a
# real, active live User — routes that record a creator or actor would
# otherwise store a dangling reference.
#
# TO VERIFY LIVE ACCESS WITHOUT REPOINTING THE PLATFORM, leave the variables
# above alone and run the read-only check with these, supplied in the shell for
# one run and never committed:
#   LIVE_NXT_SALES_BASE_URL=https://nxtsales.altiusnxt.tech \
#   LIVE_NXT_SALES_JWT_SECRET=... \
#   LIVE_NXT_SALES_SERVICE_USER_ID=... \
#   npx tsx scripts/verify-live-crm.ts

# ── Signing in ───────────────────────────────────────────────────────
# An account is created with an email address and a password, once a code sent
# to that address has proved it. No domain, certificate or OAuth client is
# needed, so what is below is the whole of the sign-in configuration.
#
# A 32+ character random secret, this platform's own (not NXT Sales').
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=""
AUTH_SESSION_HOURS=12
# Work domains whose addresses may register. Empty = only the admins below.
# This is the only thing that decides who may create an account.
AUTH_ALLOWED_EMAIL_DOMAINS="altiusnxt.com"
# The only people who may approve work, see Gemini cost, or manage access.
# Read at every sign-in and on every request: this list is the source of truth.
# They may sign in whatever their domain.
AUTH_ADMIN_EMAILS="manoj@altiusnxt.com,mohanapriya@altiusnxt.com,govind@altiusnxt.com,dtlpmanikandan@gmail.com"
# The one-time code that proves an email address. Sent with the SMTP settings
# above; without SMTP_HOST nobody can receive one.
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
# DEVELOPMENT ONLY. Returns the code in the API response when no mail server is
# configured, so the flow can be tested without a mailbox. The server REFUSES
# TO START with this on when NODE_ENV=production.
AUTH_DEV_RETURN_OTP=false
