{
  "name": "marketing-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "db:extensions": "node scripts/apply-sql.mjs sql/001_extensions.sql",
    "db:indexes": "node scripts/apply-sql.mjs sql/002_indexes.sql",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run tests/unit",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:crm": "node scripts/verify-crm.mjs",
    "ingest:fixtures": "node scripts/ingest-fixtures.mjs",
    "report:retrieval": "node scripts/retrieval-report.mjs",
    "ingest:doc": "node scripts/ingest-doc.mjs",
    "purge:fixtures": "node scripts/purge-fixtures.mjs",
    "test:all": "vitest run tests/unit tests/e2e",
    "test:integration": "node scripts/run-integration.mjs",
    "verify:live-crm": "tsx scripts/verify-live-crm.ts",
    "crm:setup-lead-source": "tsx scripts/setup-lead-source.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@paralleldrive/cuid2": "^2.2.2",
    "@prisma/client": "^5.22.0",
    "@types/pdfkit": "^0.17.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "p-limit": "^6.1.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
